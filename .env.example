# Copy this file to .env.local and fill in the values. .env.local is never committed.

# AI key for the Alert Translator until n8n is connected. Fill in ONE of these (Claude is used first if both are set).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: force one ("claude" or "gemini"), and pick the Gemini model
AI_PROVIDER=
GEMINI_MODEL=

# n8n Cloud webhook URLs (the Production URLs of the two workflows). Leave blank until n8n is set up.
N8N_CHECK_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_URL=

# A made-up password shared between this app and n8n, so only our app can call the webhooks
N8N_SHARED_SECRET=

# The only repo and site OOPS may check in the MVP
ALLOWED_REPO=
ALLOWED_SITE=

# Optional "Sign in with GitHub" (leave empty and the button shows "soon").
# Create a GitHub OAuth app with callback URL  <your-site>/api/auth/callback  then fill these in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random text, at least 32 characters. Used to sign the sign-in cookie.
SESSION_SECRET=
